# Copy to .env and fill. NEVER commit .env. Generate strong values with: openssl rand -hex 32
# LLM provider: Groq-compatible OpenAI endpoint (user supplies key). Only this endpoint receives prompts.

# --- Shared Postgres (baserow, activepieces, litellm) ---
PG_USER=isa
PG_PASSWORD=CHANGE_ME_32plus_hex
PG_DB=isa

# --- Groq / LLM gateway ---
GROQ_API_KEY=CHANGE_ME_groq_key_here
LITELLM_MASTER_KEY=CHANGE_ME_32plus_hex
# Backend model actually used by LiteLLM (Gemini, OpenAI-compatible).
GEMINI_API_KEY=CHANGE_ME_gemini_key_here
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# --- LibreChat ---
LIBRECHAT_JWT_SECRET=CHANGE_ME_32plus_hex
# Required or login authenticates but returns HTTP 500 at "[generateRefreshToken]
# Error: secretOrPrivateKey must have a value".
JWT_REFRESH_SECRET=CHANGE_ME_32plus_hex
LIBRECHAT_CREDS_KEY=CHANGE_ME_32plus_hex32
MEILI_MASTER_KEY=CHANGE_ME_32plus_hex
# Accounts created post-deploy via `node config/create-user.js`.
# student1/student2 must match the moodle-mcp MCP_STUDENTS_JSON allowlist keys
# in docker-compose.yml, because LibreChat sends {{LIBRECHAT_USER_EMAIL}}.
LIBRECHAT_ADMIN_EMAIL=admin@isa.test
LIBRECHAT_ADMIN_PASSWORD=CHANGE_ME_32plus_hex
LIBRECHAT_STUDENT_EMAIL=student1@isa.test
LIBRECHAT_STUDENT_PASSWORD=CHANGE_ME_32plus_hex
LIBRECHAT_STUDENT2_EMAIL=student2@isa.test
LIBRECHAT_STUDENT2_PASSWORD=CHANGE_ME_32plus_hex

# --- Baserow (MIT OSE only) ---
BASEROW_PUBLIC_URL=https://baserow.localhost
BASEROW_JWT=CHANGE_ME_32plus_hex
BASEROW_SECRET=CHANGE_ME_32plus_hex
# Created post-deploy (Phase C): admin login + API token for workflows.
BASEROW_ADMIN_EMAIL=admin@example.com
BASEROW_ADMIN_PASSWORD=CHANGE_ME_32plus_hex
BASEROW_API_TOKEN=CHANGE_ME_generated_via_POST_api_database_tokens

# --- Activepieces (MIT CE only) ---
AP_FRONTEND_URL=https://flows.localhost
AP_JWT_SECRET=CHANGE_ME_32plus_hex
AP_ENCRYPTION_KEY=CHANGE_ME_32plus_hex
AP_ADMIN_EMAIL=admin@isa.test
AP_ADMIN_PASSWORD=CHANGE_ME_32plus_hex

# --- Moodle (GPL v3, separate service) ---
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=CHANGE_ME_32plus_hex
MOODLE_DB_NAME=moodle
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CHANGE_ME_32plus_hex
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_URL=https://moodle.localhost
# Generated post-install (Phase B). Admin setup token + reader token (see README).
MOODLE_DEMO_PASSWORD=CHANGE_ME_32plus_hex
MOODLE_ADMIN_WS_TOKEN=CHANGE_ME_32hex_generated
MOODLE_READER_WS_TOKEN=CHANGE_ME_32hex_generated
# Restricted read-only token for the `isar` web service. This is the ONLY Moodle
# credential the moodle-mcp shim receives; it can call just these four functions:
#   core_webservice_get_site_info, core_enrol_get_users_courses,
#   core_calendar_get_calendar_events, mod_assign_get_assignments
MOODLE_ISA_READER_TOKEN=CHANGE_ME_32hex_generated

# --- FerretDB eval (Mongo-protocol for LibreChat; demo-only, see README) ---
FERRETDB_PG_USER=ferretuser
FERRETDB_PG_PASSWORD=CHANGE_ME_32plus_hex

# --- Domains (localhost default; override with real domain) ---
DOMAIN_CHAT=https://chat.localhost
DOMAIN_MOODLE=https://moodle.localhost
DOMAIN_BASEROW=https://baserow.localhost
DOMAIN_FLOWS=https://flows.localhost
